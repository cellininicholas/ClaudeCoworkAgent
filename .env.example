# Which provider drives the agent's "brain"?
#   cowork   — default. The Claude Cowork scheduled task is the LLM (no API key billed to you).
#   anthropic — direct Anthropic API. Requires ANTHROPIC_API_KEY.
#   openai    — direct OpenAI API. Requires OPENAI_API_KEY.
SIGNAL_BRAIN_PROVIDER=cowork

# --- Anthropic (only if SIGNAL_BRAIN_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
SIGNAL_BRAIN_MODEL=claude-haiku-4-5-20251001
SIGNAL_BRAIN_WRITER_MODEL=claude-sonnet-4-6

# --- OpenAI (only if SIGNAL_BRAIN_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: route to an OpenAI-compatible endpoint (Together, OpenRouter, local Ollama, etc.)
# OPENAI_BASE_URL=https://api.together.xyz/v1

# --- Storage / UI ---
SIGNAL_BRAIN_DB=data/signal.db
SIGNAL_BRAIN_PORT=8787

# Optional: SIGNAL_BRAIN_JOURNAL_MODE=WAL
# Default is MEMORY + synchronous=OFF for compatibility with FUSE/virtiofs
# mounts (Cowork sandbox). If you're running on a normal local filesystem and
# want WAL durability + concurrent reads, set this to WAL.
